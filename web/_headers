# Cloudflare Pages headers – Flutter web
# https://developers.cloudflare.com/pages/configuration/headers/
# SECURITY: Applied to all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# HTML / entrypoint: never cache – ensures new deploys are picked up immediately
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Frame-Options: DENY
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Flutter bootstrap / service worker: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/flutter.js
  Cache-Control: no-cache

# Hashed assets: immutable long cache (canvaskit, assets, icons)
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.wasm
  Cache-Control: public, max-age=31536000, immutable

# _redirects / _headers themselves: no-cache
/_redirects
  Cache-Control: no-cache
/_headers
  Cache-Control: no-cache
